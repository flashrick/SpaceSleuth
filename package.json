{
  "name": "disk-scan-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "DiskScan MCP: a read-only cross-platform disk usage scanner and cleanup review server.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "disk-scan-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
